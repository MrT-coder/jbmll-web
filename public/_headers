# Cabeceras de seguridad. Cloudflare Pages lee este archivo y las aplica en el
# borde; no hay servidor propio donde configurarlas.
#
# Dos cosas que este archivo NO decide, aprendidas a los golpes el 2026-09-17:
#
# 1) Dentro de un bloque, un Cache-Control declarado ANTES de las líneas
#    «! Cabecera» que desprenden herencia se ignora. Va al final, como en
#    /media/* más abajo.
# 2) La zona del dominio puede sobrescribir lo de acá. Con «Browser Cache TTL»
#    en 4 horas —el valor por omisión del plan gratuito— Cloudflare eleva todo
#    tiempo más corto que el suyo: la hora de /media/* salía como cuatro,
#    mientras el año de las fuentes sobrevivía. Está en «Respect Existing
#    Headers», y si alguna vez los tiempos de producción no coinciden con este
#    archivo, ese ajuste es el primer sospechoso. En un despliegue de vista
#    previa (pages.dev) no interviene, así que ahí sí se ve lo declarado.

/*
  # 'none' por defecto: cada permiso se concede a mano y lo que se olvide queda
  # bloqueado, no permitido. Es la única forma de que la lista no se pudra.
  # No hay 'unsafe-inline' en script-src porque el script del sitio es un
  # archivo aparte. Si algún día vuelve un script en línea, esto lo rompe: esa
  # rotura es la señal, no el estorbo.
  # El visor de certificados incrusta un PDF propio con <object> (ver
  # src/components/Visor.astro); sin el permiso que agrega la línea de abajo,
  # default-src 'none' lo bloquea y el panel se abre vacío. Se concede solo al
  # propio origen — nada de blob:, data: ni un origen ajeno.
  # frame-src, no solo object-src: Chromium pinta un PDF incrustado en un
  # marco interno, así que sin él la política lo bloquea y el visor cae a su
  # enlace de emergencia. No se vio en local porque astro preview no aplica
  # este archivo; se vio en producción.
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

  # Sin preload: la lista de HSTS del navegador es prácticamente irreversible y
  # se entra ahí a propósito, no de paso.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # El navegador deja de adivinar el tipo de un archivo por su contenido, que es
  # como un .txt subido termina ejecutándose como script.
  X-Content-Type-Options: nosniff

  # frame-ancestors ya lo cubre; esto es para los navegadores que no leen CSP.
  X-Frame-Options: DENY

  # Hacia otro sitio solo viaja el origen, nunca la ruta ni la consulta.
  Referrer-Policy: strict-origin-when-cross-origin

  # El sitio no usa ninguna de estas capacidades: se renuncia a todas para que
  # un script inyectado tampoco pueda pedirlas.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()

  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# El nombre de estos archivos incluye su hash: si el contenido cambia, cambia la
# URL. Por eso pueden guardarse para siempre sin quedar obsoletos.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Los certificados y la foto. Cloudflare Pages aplica las cabeceras a TODAS las
# respuestas, incluida la del PDF, así que el propio archivo llegaba diciendo
# `frame-ancestors 'none'`: el visor lo incrusta en un marco y el navegador se
# lo negaba a sí mismo, con «El navegador no pudo mostrar el PDF» en pantalla.
# Acá se permite enmarcarlo, pero solo desde este mismo origen —nadie más puede
# meter estos archivos en su página— y el resto del sitio conserva su `none`.
# X-Frame-Options se repite porque los navegadores que no leen CSP miran esa, y
# DENY heredado bloquearía lo mismo.
/media/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; frame-ancestors 'self'
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  # Al final del bloque a propósito: declarado antes de las líneas que
  # desprenden cabeceras, Cloudflare Pages lo ignoraba y servía sus 4 horas por
  # omisión (comprobado en producción el 2026-09-17). Una hora y no para
  # siempre, porque el panel reemplaza estos archivos con el mismo nombre.
  Cache-Control: public, max-age=3600

# El panel de administración (Sveltia CMS, autohospedado desde /admin/, ver
# public/admin/) no puede vivir bajo la CSP del resto del sitio: necesita
# cargar sus tipografías e íconos desde cdn.jsdelivr.net, hablar con
# api.github.com y mostrar el avatar de quien inició sesión, que GitHub sirve
# desde avatars.githubusercontent.com. Sin los hosts de OAuth (github.com,
# api.netlify.com): el backend solo permite "Sign In Using Access Token"
# (auth_methods: [token] en config.yml), así que ese flujo nunca corre.
#
# unpkg.com y www.githubstatus.com solo en connect-src: el panel consulta ahí
# su propia versión publicada y el estado del servicio de GitHub. No hay
# opción para apagar esas dos consultas (buscadas en el bundle: solo existe
# disable_x_locale), y bloquearlas deja dos errores de CSP en cada carga. El
# bundle sigue viniendo del propio origen: script-src se queda en 'self', así
# que el resaltado de Markdown, que Sveltia carga de unpkg (@shikijs), no
# funciona. Es cosmético y no vale abrir script-src a un CDN.
#
# Cuando una petición calza con más de una regla, Cloudflare Pages combina las
# cabeceras repetidas con una coma en vez de reemplazarlas, así que la CSP del
# sitio (arriba) y esta se sumarían en una sola cabecera contradictoria. `!
# Content-Security-Policy` desprende la heredada antes de declarar la propia
# (docs: https://developers.cloudflare.com/pages/configuration/headers/).
# Verificado en el despliegue de vista previa de esta PR: /admin/ responde
# solo con la CSP de abajo, sin la del sitio.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://avatars.githubusercontent.com; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' blob: data: https://api.github.com https://unpkg.com https://www.githubstatus.com; media-src blob:; frame-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex

# `/admin/*` no calza con la ruta exacta `/admin`, sin barra final. Se repite
# el mismo bloque para esa ruta puntual, por si Cloudflare Pages la sirve sin
# redirigir antes a `/admin/`.
/admin
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://avatars.githubusercontent.com; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' blob: data: https://api.github.com https://unpkg.com https://www.githubstatus.com; media-src blob:; frame-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex
