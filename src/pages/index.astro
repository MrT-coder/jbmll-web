---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { getIndice, getPerfil, INICIO } from '../lib/content';
import { renderSecciones } from '../lib/render';

const indice = await getIndice();
const perfil = getPerfil();

const INFO = [
  ['autor', perfil.nombre],
  ['rol', perfil.titular],
  ['ubicación', perfil.ubicacion],
  ['stack', `${indice.stack.length} tecnologías, contadas desde los datos`],
];
---

<Base
  title={INICIO.titulo}
  description="Desarrollador backend Java. Proyectos, publicaciones y notas, en una terminal que se navega con comandos o con clic."
>
  <Terminal seccion="" boot lead={INICIO.lead} salida={renderSecciones(indice.secciones)}>
    <dl slot="info">
      {
        INFO.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))
      }
    </dl>
  </Terminal>
</Base>
