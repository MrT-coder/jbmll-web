---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Visor from '../components/Visor.astro';
import { render } from 'astro:content';
import {
  getPagina,
  getPerfil,
  getExperiencia,
  getEducacion,
  getCertificaciones,
  getStack,
  getTechsConPagina,
  MINIMO_PARA_PAGINA_DE_STACK,
  seccionDe,
} from '../lib/content';
import { renderStack, slugTech, rutaMedia } from '../lib/render';
import { iconoDe } from '../data/iconos';

const [perfil, pagina, experiencia, educacion, certificaciones, stack, conPagina] = await Promise.all([
  getPerfil(),
  getPagina('sobre-mi'),
  getExperiencia(),
  getEducacion(),
  getCertificaciones(),
  getStack(),
  getTechsConPagina(),
]);

// La prosa la escribe el Markdown; los bloques de abajo salen de los datos.
const Prosa = pagina ? (await render(pagina)).Content : null;
const { titulo, lead } = await seccionDe('sobre-mi');

// Experiencia, certificaciones y educación son colecciones separadas en los
// datos y bloques de una sola página en la vista. El día que crezcan se
// independizan sin migrar nada.
const periodo = (inicio: string, fin?: string) => `${inicio} — ${fin ?? 'presente'}`;
---

<Base
  title={titulo}
  description={`${perfil.titular}. Experiencia, formación, certificaciones y el stack calculado desde los datos.`}
>
  <Terminal seccion="sobre-mi" salida="">
    <section class="bloque">
      <h1 class="out lead">{lead}</h1>
      <p class="out note"># {perfil.titular} · {perfil.ubicacion}</p>
      {Prosa && <div class="prose intro"><Prosa /></div>}
    </section>

    <section class="bloque" id="stack">
      <h2 class="bloque-t">stack</h2>
      <p class="out note">
        # no está escrito a mano: se suma desde lo que declara cada trabajo y cada proyecto
      </p>
      <div set:html={renderStack(stack, MINIMO_PARA_PAGINA_DE_STACK)} />
    </section>

    <section class="bloque" id="experiencia">
      <h2 class="bloque-t">experiencia</h2>
      {
        experiencia.map((e) => (
          <article class="item">
            <h3 class="item-t">
              {e.data.puesto} <span class="item-org">· {e.data.organizacion}</span>
            </h3>
            <p class="item-m">
              {periodo(e.data.inicio, e.data.fin)} · {e.data.ubicacion}
              {e.data.modalidad && ` · ${e.data.modalidad}`}
            </p>
            {e.data.st.length > 0 && (
              <ul class="chips">
                {e.data.st.map((t) => (
                  <li>
                    {conPagina.has(t) ? (
                      <a class="chip" href={`/stack/${slugTech(t)}`}>
                        <span class="ico" aria-hidden="true">{iconoDe(t)}</span>{t}
                      </a>
                    ) : (
                      <span class="chip">
                        <span class="ico" aria-hidden="true">{iconoDe(t)}</span>{t}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section class="bloque" id="educacion">
      <h2 class="bloque-t">educación</h2>
      {
        educacion.map((e) => (
          <article class="item">
            <h3 class="item-t">
              {e.data.titulo} <span class="item-org">· {e.data.institucion}</span>
            </h3>
            <p class="item-m">
              {periodo(e.data.inicio, e.data.fin)} · {e.data.ubicacion}
              {e.data.registro && ` · ${e.data.registro}`}
            </p>
          </article>
        ))
      }
    </section>

    <section class="bloque" id="certificaciones">
      <h2 class="bloque-t">certificaciones y cursos</h2>
      <table class="list list-certs">
        <tbody>
          {
            certificaciones.map((c) => (
              <tr>
                <td class="n">{c.data.nombre}</td>
                <td class="c">{c.data.fecha ?? '—'}</td>
                <td class="d">
                  {[c.data.emisor, c.data.horas && `${c.data.horas} h`].filter(Boolean).join(' · ')}
                </td>
                <td class="acc">
                  {c.data.archivo && (
                    <a
                      class="go visor-abrir"
                      href={rutaMedia(c.data.archivo)}
                      target="_blank"
                      rel="noopener"
                      aria-label={`ver el certificado ${c.data.nombre}`}
                      data-nombre={c.data.nombre}
                    >
                      [ver]
                    </a>
                  )}
                  {c.data.url && (
                    <a
                      class="go"
                      href={c.data.url}
                      target="_blank"
                      rel="noopener"
                      aria-label={`verificar el certificado ${c.data.nombre}`}
                    >
                      [verificar]
                    </a>
                  )}
                  {c.data.credencial && <span class="cred">{c.data.credencial}</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <Visor />
    </section>
  </Terminal>
</Base>

<style>
  .bloque {
    margin: var(--space-7) 0;
  }

  .bloque-t {
    margin: 0 0 var(--space-3);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--green);
  }

  .bloque-t::before {
    content: '## ';
    color: var(--dim);
  }

  .item {
    margin: 0 0 var(--space-6);
    padding-left: 1.5ch;
    border-left: 1px solid var(--line);
  }

  .item-t {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 700;
  }

  .item-org {
    font-weight: 400;
    color: var(--muted);
  }

  .item-m {
    margin: var(--space-1) 0 0;
    color: var(--dim);
    font-size: var(--text-sm);
  }

  /* [ver]/[verificar] y la credencial, en la misma celda: flex y no una lista,
     porque no siempre están los tres — una certificación puede traer solo uno
     o ninguno. */
  .acc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  /* Discreta a propósito: el id de credencial no es información que alguien
     lea primero, es una prueba que queda ahí para quien la necesite. */
  .cred {
    color: var(--dim);
    font-size: var(--text-xs);
  }

  /* Cuatro columnas no caben en un teléfono: a 390px los nombres largos se
     partían carácter por carácter («Fund acio n Carl»). Solo esta tabla se
     apila —.list también arma la de contacto y la de stack, que sí caben—, y
     cada certificación pasa a ser un bloque con su nombre, su fecha, su
     emisor y sus enlaces uno debajo del otro. Mismo punto de quiebre que el
     resto del sitio. */
  @media (max-width: 660px) {
    .list-certs tr {
      display: grid;
      gap: var(--space-1);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--line);
    }

    /* Apilada, la alineación de una columna deja de tener sentido: cada dato
       arranca donde arranca el nombre. */
    .list-certs td {
      padding: 0;
      text-align: left;
    }

    /* Una certificación sin emisor o sin enlaces dejaba una fila en blanco
       dentro de su bloque, que se leía como un dato que falta cargar. */
    .list-certs td:empty {
      display: none;
    }
  }
</style>
