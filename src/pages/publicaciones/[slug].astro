---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import { getPublicaciones, tieneCuerpo } from '../../lib/content';

// Solo las que tienen algo propio que decir. Una publicación que se agota en su
// enlace al editor no genera página: sería un título repetido compitiendo con
// el original en los buscadores.
export const getStaticPaths: GetStaticPaths = async () => {
  const publicaciones = await getPublicaciones();
  return publicaciones
    .filter(tieneCuerpo)
    .map((p) => ({ params: { slug: p.id }, props: { publicacion: p } }));
};

const { publicacion } = Astro.props;
const { Content } = await render(publicacion);
const doi = publicacion.data.doi ? `https://doi.org/${publicacion.data.doi}` : publicacion.data.url;
---

<Base
  title={`${publicacion.data.titulo} — JBMLL`}
  description={`${publicacion.data.venue} · ${publicacion.data.anio}`}
>
  <Terminal seccion="publicaciones" salida="">
    <article class="lectura">
      <h1 class="lectura-t">{publicacion.data.titulo}</h1>
      <p class="lectura-m">
        {publicacion.data.autores.join('; ')} · {publicacion.data.anio} · {publicacion.data.venue}
      </p>
      <Content />
      <p class="lectura-fin">
        {doi && <a class="go" href={doi} rel="noopener">{publicacion.data.doi ?? 'enlace'}</a>}
        <a class="go" href="/publicaciones">← volver a publicaciones</a>
      </p>
    </article>
  </Terminal>
</Base>
