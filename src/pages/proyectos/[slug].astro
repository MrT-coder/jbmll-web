---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import { getProyectos } from '../../lib/content';
import { slugTech } from '../../lib/render';

export const getStaticPaths: GetStaticPaths = async () => {
  const proyectos = await getProyectos();
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { proyecto: p } }));
};

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);

// El cuerpo lo procesa Astro al compilar. En el navegador no entra ni un byte
// de analizador de Markdown.
---

<Base title={`${proyecto.data.titulo} — JBMLL`} description={proyecto.data.desc}>
  <Terminal seccion="proyectos" salida="">
    <article class="lectura">
      <h1 class="lectura-t">{proyecto.data.titulo}</h1>
      <p class="lectura-m">{proyecto.data.fecha}{proyecto.data.organizacion && ` · ${proyecto.data.organizacion}`}</p>
      <ul class="chips">
        {
          proyecto.data.st.map((t) => (
            <li>
              <a class="chip" href={`/stack/${slugTech(t)}`}>
                {t}
              </a>
            </li>
          ))
        }
      </ul>
      <Content />
      <p class="lectura-fin">
        <a class="go" href="/proyectos">← volver a proyectos</a>
      </p>
    </article>
  </Terminal>
</Base>
