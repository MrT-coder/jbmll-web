---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import Visor from '../../components/Visor.astro';
import { getProyectos, getTechsConPagina, vecinos, ETIQUETAS_ESTADO, ETIQUETAS_CONTEXTO } from '../../lib/content';
import { slugTech } from '../../lib/render';

export const getStaticPaths = async () => {
  const [proyectos, conPagina] = await Promise.all([getProyectos(), getTechsConPagina()]);
  return proyectos.map((p) => ({
    params: { slug: p.id },
    props: { proyecto: p, conPagina, ...vecinos(proyectos, p.id) },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { proyecto, conPagina, anterior, siguiente } = Astro.props;

// El cuerpo lo procesa Astro al compilar. Al navegador no llega ni un byte de
// analizador de Markdown.
const { Content } = await render(proyecto);

// Mismo criterio que metaDeFila() en src/lib/render.ts, para que el índice y
// esta página de detalle lean exactamente lo mismo: el estado va coloreado y
// aparte, el contexto (si existe) justo después, y el resto de la línea
// (organización, fecha) cierra igual que antes.
const estadoEtiqueta = ETIQUETAS_ESTADO[proyecto.data.estado];
const contextoEtiqueta = proyecto.data.contexto ? ETIQUETAS_CONTEXTO[proyecto.data.contexto] : null;
const meta = [proyecto.data.organizacion, proyecto.data.fecha].filter(Boolean).join(' · ');
---

<Base title={`${proyecto.data.titulo} — JBMLL`} description={proyecto.data.desc}>
  <Terminal
    seccion="proyectos"
    salida=""
    detalle
    documento={{ href: `/proyectos/${proyecto.id}`, titulo: proyecto.data.titulo, tipo: 'proyecto' }}
  >
    <article class="lectura">
      <h1 class="lectura-t">{proyecto.data.titulo}</h1>
      <p class="lectura-m">
        <span class={`estado estado-${proyecto.data.estado}`}>{estadoEtiqueta}</span>
        {contextoEtiqueta && ` · ${contextoEtiqueta}`}
        {meta && ` · ${meta}`}
      </p>

      <ul class="chips">
        {
          proyecto.data.st.map((t) => (
            <li>
              {conPagina.has(t) ? (
                <a class="chip" href={`/stack/${slugTech(t)}`}>
                  {t}
                </a>
              ) : (
                <span class="chip">{t}</span>
              )}
            </li>
          ))
        }
      </ul>

      <div class="prose">
        <Content />
      </div>

      <!-- El visor flotante que rehype-figuras.mjs ya sabe usar (clase
           visor-abrir en cada figura y en cada PDF propio del cuerpo): sin
           este componente aquí, esos enlaces existen en el HTML pero no hay
           ningún <dialog id="visor"> que scripts/visor.ts pueda abrir — el
           mismo candado que ya hace falta en /sobre-mi para certificados. -->
      <Visor />

      <footer class="eof">
        <p class="eof-mark">(END)</p>
        <ul class="eof-acts">
          <li>
            <a href="/proyectos"><kbd>q</kbd>volver a proyectos</a>
          </li>
          {
            anterior && (
              <li>
                <a href={`/proyectos/${anterior.id}`}>
                  <kbd>k</kbd>
                  {anterior.data.titulo}
                </a>
              </li>
            )
          }
          {
            siguiente && (
              <li>
                <a href={`/proyectos/${siguiente.id}`}>
                  <kbd>j</kbd>
                  {siguiente.data.titulo}
                </a>
              </li>
            )
          }
        </ul>
      </footer>
    </article>
  </Terminal>
</Base>
