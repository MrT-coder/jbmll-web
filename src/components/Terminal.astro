---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/terminal.css';
import bannerRaw from '../data/banner.txt?raw';
import { SECCIONES } from '../lib/content';
import Sidebar from './Sidebar.astro';
import Statusline from './Statusline.astro';
import type { DocumentoAbierto } from '../lib/tipos';

interface Props {
  /** Sección montada, o null en la raíz. Decide la ruta y el workspace activo. */
  seccion?: string | null;
  /** Salida inicial, ya renderizada por src/lib/render.ts. */
  salida?: string;
  /** El arranque solo tiene sentido la primera vez, en la raíz. */
  boot?: boolean;
  /** Frase de encabezado, cuando la página tiene algo que decir antes. */
  lead?: string;
  /** True en una página de detalle: el workspace de `seccion` es su padre, no
   * su propia raíz. Decide si la barra lateral marca `location` o `page`. */
  detalle?: boolean;
  /** El documento propio, en una página de detalle. La barra lateral lo sirve
   * como el único «leyendo» en abiertos, sin depender de JavaScript. */
  documento?: DocumentoAbierto | null;
  /** Sustituye el comando por defecto (`cd <sección>`) cuando ese cálculo no
   * describe la página: una de /stack/<tech> monta `seccion="sobre-mi"` solo
   * para que la barra lateral marque ese workspace como padre, y `cd sobre-mi`
   * ahí sería un comando falso. Sin ella, el comportamiento no cambia. */
  comando?: string;
  /** Foto del perfil para el bloque de arranque, estilo neofetch. Viene de
   * perfil.yaml (campo opcional `foto`); ausente, el arranque cae al banner
   * ASCII de siempre. */
  foto?: { src: string; alt: string } | null;
}

const {
  seccion = null,
  salida = '',
  boot = false,
  lead,
  detalle = false,
  documento = null,
  comando: comandoProp,
  foto = null,
} = Astro.props;

// Los espacios finales son parte del dibujo y los editores los borran, así que
// el ancho se restituye acá. El \r se limpia por finales de línea de Windows.
const rows = bannerRaw
  .replace(/\r/g, '')
  .replace(/\n+$/, '')
  .split('\n');
const width = Math.max(...rows.map((r) => r.length));
const banner = rows.map((r) => r.padEnd(width)).join('\n');

// Lee el tamaño real de la foto desde sus propios bytes (marcador SOF del
// JPEG): public/ no pasa por el pipeline de imágenes de Astro (astro:assets
// no sirve archivos de public/ tal cual), así que sin esto el <img> tendría
// que asumir un tamaño fijo y dejaría de ser el real en cuanto el dueño
// reemplace la foto desde /admin. Solo cubre JPEG porque es el único formato
// que produce este flujo hoy: uno distinto rompe el build con un error
// explícito en vez de servir un width/height inventado.
function tamanoJpeg(ruta: string): { width: number; height: number } {
  const buf = readFileSync(ruta);
  let i = 2;
  while (i < buf.length) {
    if (buf[i] !== 0xff) {
      i++;
      continue;
    }
    const marcador = buf[i + 1];
    if (marcador === 0xd8 || marcador === 0xd9) {
      i += 2;
      continue;
    }
    if (marcador >= 0xd0 && marcador <= 0xd7) {
      i += 2;
      continue;
    }
    const largo = buf.readUInt16BE(i + 2);
    const esSOF =
      (marcador >= 0xc0 && marcador <= 0xc3) ||
      (marcador >= 0xc5 && marcador <= 0xc7) ||
      (marcador >= 0xc9 && marcador <= 0xcb) ||
      (marcador >= 0xcd && marcador <= 0xcf);
    if (esSOF) return { height: buf.readUInt16BE(i + 5), width: buf.readUInt16BE(i + 7) };
    i += 2 + largo;
  }
  throw new Error(`No se encontró el marcador SOF de JPEG en ${ruta}`);
}

// process.cwd() es la raíz del repo durante `astro build`/`astro dev`, igual
// que asume scripts/verify.mjs con sus propias rutas relativas.
const fotoTam = foto ? tamanoJpeg(join(process.cwd(), 'public', foto.src)) : null;

// Área de Uso Privado de Unicode: solo existe gracias a la fuente empaquetada.
const BRAIN = '';
// Viaja por data-brain y no por define:vars: define:vars obliga a Astro a
// dejar el script en línea, y un script en línea exige aflojar la CSP.

const BOOT = [
  ['0.000000', 'jbsh 1.0 — arrancando'],
  ['0.118431', 'montando ' + SECCIONES.map((s) => '/' + s.slug).join(' ')],
  ['0.240902', 'FiraCode Nerd Font Mono · subconjunto de 432 glifos'],
  ['0.402118', 'listo'],
];

const ruta = seccion ? `~/${seccion}` : '~/';

// El comando que dejó la pantalla así. Se muestra ejecutado, no se ejecuta:
// quien llega desde un buscador ve la terminal en el estado de esa URL. Una
// página puede imponer el suyo con `comando` cuando `cd <sección>` no la
// describe (ver el comentario de la prop, arriba).
const comando = comandoProp ?? (seccion ? `cd ${seccion}` : 'ls');

// El valor sin JavaScript para la statusline: el servidor solo conoce el
// documento propio de esta página, si lo hay. sidebar.ts lo corrige apenas
// fusiona la lista con lo que había en la sesión.
const abiertosSsr = documento ? 1 : 0;
---

<!-- Primero en el orden de tabulación: sin él, quien navega con teclado
     atraviesa toda la barra lateral en cada página antes de llegar al
     contenido. #term ya lleva tabindex="-1", así que recibe el foco. -->
<a class="saltar" href="#term">saltar al contenido</a>

<div class="shell">
  <Sidebar actual={seccion} detalle={detalle} documento={documento} />

  <main class="term" id="term" tabindex="-1" data-brain={BRAIN} data-seccion={seccion ?? ''} data-detalle={detalle ? '1' : ''}>
    <div class="wrap">
      <div id="scroll" aria-live="polite">
        {
          boot && (
            <div class="boot">
              {BOOT.map(([t, msg]) => (
                <div class="out">
                  <span class="t">[ {t} ] </span>{msg}
                  {msg === 'listo' && <span class="ok">  ok</span>}
                </div>
              ))}
            </div>
          )
        }

        {
          boot && (
            <div class="fetch">
              {foto && fotoTam ? (
                <img
                  class="foto"
                  src={foto.src}
                  alt={foto.alt}
                  width={fotoTam.width}
                  height={fotoTam.height}
                  decoding="async"
                />
              ) : (
                <pre class="logo" aria-hidden="true">{banner}</pre>
              )}
              <div class="info">
                <p class="title">
                  <span class="u">josue</span><span class="at">@</span><span class="h">jbmll-web</span>
                </p>
                <div class="rule">{'─'.repeat(30)}</div>
                <slot name="info" />
              </div>
            </div>
          )
        }

        {lead && <h1 class="out lead" set:html={lead} />}

        <div class="out done">
          <span class="brain ok">{BRAIN}</span><span class="typed">{comando}</span>
        </div>

        <div id="salida" set:html={salida}></div>

        <slot />
        <div class="out sp"></div>
      </div>
    </div>
  </main>
</div>

<Statusline ruta={ruta} abiertos={abiertosSsr} />

<footer class="foot">
  <span>© 2026 Josue Bladimir Morales Llanganate</span>
  <span class="spacer"></span>
  <a href="https://github.com/MrT-coder" rel="me noopener">github</a>
</footer>

<script>
  // La terminal vive en un .ts para que `tsc` la revise: un script suelto
  // dentro de un .astro no lo comprueba nadie.
  import '../scripts/terminal';
</script>

<style>
  /* El comando que dejó la pantalla en este estado, mostrado ya ejecutado. */
  .done .brain {
    margin-right: 1ch;
    color: var(--green);
  }

  /* La barra lateral y el contenido, uno al lado del otro. Sin flex-shrink: 0
     en .sidebar (ver sidebar.css) el navegador le quita ancho cuando falta
     espacio, y el texto de cada workspace se aprieta hasta ser ilegible. */
  .shell {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    overflow: hidden;
  }

  .term {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: var(--space-6) 0 var(--space-3);
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .term::-webkit-scrollbar {
    width: 9px;
  }
  .term::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 9px;
  }

  .sp {
    height: 0.9rem;
  }

  .boot {
    color: var(--dim);
    font-size: var(--text-sm);
  }
  .boot .t {
    color: var(--muted);
  }
  .boot .ok {
    color: var(--green);
  }

  /* flex-wrap y no overflow-x: con scroll el panel se recorta y el último
     valor queda fuera de la vista sin ningún indicio. */
  .fetch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) clamp(var(--space-5), 3vw, var(--space-8));
    margin: var(--space-6) 0 var(--space-7);
  }
  .logo {
    flex: 0 0 auto;
    margin: 0;
    white-space: pre;
    line-height: 1.05;
    font-size: clamp(7.5px, 1.28vw, 12px);
    color: var(--green);
  }
  /* max-width y no width: sin una propiedad `width` propia, el navegador
     usa el tamaño intrínseco de la imagen (los atributos width/height de la
     etiqueta, ver el bloque de arranque arriba) como su ancho por defecto, y
     max-width solo puede achicarlo. Así escala con la cuadrícula tipográfica
     hasta 12ch, pero nunca la agranda más allá de su tamaño real — sin
     necesitar ese número (que depende del archivo que suba el dueño) dentro
     de una regla CSS estática, algo que la CSP del sitio no permite inyectar
     en línea (style-src 'self', sin 'unsafe-inline': ver public/_headers). */
  .foto {
    flex: 0 0 auto;
    display: block;
    /* 24ch iguala la altura del bloque de datos de al lado, que es la
       proporción del neofetch que inspira este bloque; a 12ch la foto queda
       chica y el panel se ve desequilibrado. El atributo width del archivo
       sigue siendo el techo: si la foto es más chica que 24ch, manda ella. */
    max-width: 24ch;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--line);
    /* Ajuste sutil para que la foto no desentone de la paleta de la terminal,
       sin perder que se reconozca a quien retrata. */
    filter: saturate(1.05) contrast(1.05);
  }
  /* Sin min-width el panel se aprieta hasta ser ilegible en vez de bajar. */
  .info {
    flex: 1 1 26ch;
    min-width: min(26ch, 100%);
  }
  .info .title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
    font-weight: 700;
  }
  .info .u {
    color: var(--pink);
  }
  .info .at {
    color: var(--muted);
    font-weight: 400;
  }
  .info .h {
    color: var(--cyan);
  }
  .info .rule {
    /* --line mide 1.41:1 sobre --bg (QA 2026-09-17): muy por debajo de las
       3:1 de WCAG 1.4.11 para un separador no textual. --dim, ya usado en
       texto atenuado, sí las cumple. */
    color: var(--dim);
    margin-bottom: var(--space-2);
  }
  .info dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 var(--space-5);
    margin: 0;
  }
  .info dt {
    color: var(--blue);
  }
  .info dd {
    margin: 0;
    color: var(--fg);
  }

  .lead {
    color: var(--fg);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--lh-snug);
    text-wrap: balance;
    margin: 0 0 var(--space-5);
    max-width: 46ch;
  }
  .lead strong {
    color: var(--fg);
    font-weight: 700;
  }
  .lead .sig {
    color: var(--green);
    font-weight: 700;
  }
  .note {
    color: var(--dim);
    margin: 0;
  }

  /* La barra de estado vive en Statusline.astro: sus reglas están ahí. Este
     .spacer es del pie de página, que sigue viviendo acá. */
  .spacer {
    flex: 1 1 auto;
  }

  /* Debajo de la statusline y no dentro: lo legal tiene que ser rastreable.
     A todo el ancho del visor, como la statusline: .wrap lo dejaba centrado
     en una columna de 96ch, desalineado del resto de la maqueta. */
  .foot {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) clamp(var(--space-4), 3vw, var(--space-7));
    background: var(--bg);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--dim);
  }
  .foot a {
    color: var(--dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .foot a:hover,
  .foot a:focus-visible {
    color: var(--blue);
    border-bottom-color: var(--blue);
  }

  @media (max-width: 660px) {
    /* La barra lateral se apila arriba del contenido en vez de ir al costado:
       a este ancho no hay sitio para las dos columnas. */
    .shell {
      flex-direction: column;
    }
    /* flex-direction y no flex-wrap solo: el banner ASCII es tan ancho que ya
       se apilaba solo por desbordar la fila, pero la foto (acotada a 12ch) sí
       cabría junto al panel de info sin este empujón explícito. */
    .fetch {
      flex-direction: column;
      gap: var(--space-6);
    }
    .logo {
      align-self: center;
      font-size: clamp(7.5px, 2.6vw, 12px);
    }
    .foto {
      align-self: center;
    }
    .lead {
      font-size: var(--text-md);
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .term {
      cursor: default;
    }
  }
</style>
