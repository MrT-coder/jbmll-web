---
import '../styles/terminal.css';
import bannerRaw from '../data/banner.txt?raw';
import { SECCIONES } from '../lib/content';
import { esc } from '../lib/render';
import Sidebar from './Sidebar.astro';
import Statusline from './Statusline.astro';
import type { DocumentoAbierto } from '../lib/tipos';

interface Props {
  /** Sección montada, o null en la raíz. Decide la ruta y el workspace activo. */
  seccion?: string | null;
  /** Salida inicial, ya renderizada por src/lib/render.ts. */
  salida?: string;
  /** El arranque solo tiene sentido la primera vez, en la raíz. */
  boot?: boolean;
  /** Frase de encabezado, cuando la página tiene algo que decir antes. */
  lead?: string;
  /** True en una página de detalle: el workspace de `seccion` es su padre, no
   * su propia raíz. Decide si la barra lateral marca `location` o `page`. */
  detalle?: boolean;
  /** El documento propio, en una página de detalle. La barra lateral lo sirve
   * como el único «leyendo» en abiertos, sin depender de JavaScript. */
  documento?: DocumentoAbierto | null;
}

const { seccion = null, salida = '', boot = false, lead, detalle = false, documento = null } = Astro.props;

// Los espacios finales son parte del dibujo y los editores los borran, así que
// el ancho se restituye acá. El \r se limpia por finales de línea de Windows.
const rows = bannerRaw
  .replace(/\r/g, '')
  .replace(/\n+$/, '')
  .split('\n');
const width = Math.max(...rows.map((r) => r.length));
const banner = rows.map((r) => r.padEnd(width)).join('\n');

// Área de Uso Privado de Unicode: solo existe gracias a la fuente empaquetada.
const BRAIN = '';
// Viaja por data-brain y no por define:vars: define:vars obliga a Astro a
// dejar el script en línea, y un script en línea exige aflojar la CSP.

const BOOT = [
  ['0.000000', 'jbsh 1.0 — arrancando'],
  ['0.118431', 'montando ' + SECCIONES.map((s) => '/' + s.slug).join(' ')],
  ['0.240902', 'FiraCode Nerd Font Mono · subconjunto de 432 glifos'],
  ['0.402118', 'listo'],
];

const ruta = seccion ? `~/${seccion}` : '~/';

// El comando que dejó la pantalla así. Se muestra ejecutado, no se ejecuta:
// quien llega desde un buscador ve la terminal en el estado de esa URL.
const comando = seccion ? `cd ${seccion}` : 'ls';

// El valor sin JavaScript para la statusline: el servidor solo conoce el
// documento propio de esta página, si lo hay. sidebar.ts lo corrige apenas
// fusiona la lista con lo que había en la sesión.
const abiertosSsr = documento ? 1 : 0;
---

<!-- Primero en el orden de tabulación: sin él, quien navega con teclado
     atraviesa toda la barra lateral en cada página antes de llegar al
     contenido. #term ya lleva tabindex="-1", así que recibe el foco. -->
<a class="saltar" href="#term">saltar al contenido</a>

<div class="shell">
  <Sidebar actual={seccion} detalle={detalle} documento={documento} />

  <main class="term" id="term" tabindex="-1" data-brain={BRAIN} data-seccion={seccion ?? ''} data-detalle={detalle ? '1' : ''}>
    <div class="wrap">
      <div id="scroll" aria-live="polite">
        {
          boot && (
            <div class="boot">
              {BOOT.map(([t, msg]) => (
                <div class="out">
                  <span class="t">[ {t} ] </span>{msg}
                  {msg === 'listo' && <span class="ok">  ok</span>}
                </div>
              ))}
            </div>
          )
        }

        {
          boot && (
            <div class="fetch">
              <pre class="logo" aria-hidden="true">{banner}</pre>
              <div class="info">
                <p class="title">
                  <span class="u">josue</span><span class="at">@</span><span class="h">jbmll-web</span>
                </p>
                <div class="rule">{'─'.repeat(30)}</div>
                <slot name="info" />
              </div>
            </div>
          )
        }

        {lead && <h1 class="out lead" set:html={lead} />}

        <div class="out done">
          <span class="brain ok">{BRAIN}</span><span class="typed">{comando}</span>
        </div>

        <div id="salida" set:html={salida}></div>

        <slot />
        <div class="out sp"></div>
      </div>
    </div>
  </main>
</div>

<Statusline ruta={ruta} abiertos={abiertosSsr} />

<footer class="foot">
  <span>© 2026 Josue Bladimir Morales Llanganate</span>
  <span class="spacer"></span>
  <a href="https://github.com/MrT-coder" rel="me noopener">github</a>
</footer>

<script>
  // La terminal vive en un .ts para que `tsc` la revise: un script suelto
  // dentro de un .astro no lo comprueba nadie.
  import '../scripts/terminal';
</script>

<style>
  /* El comando que dejó la pantalla en este estado, mostrado ya ejecutado. */
  .done .brain {
    margin-right: 1ch;
    color: var(--green);
  }

  /* La barra lateral y el contenido, uno al lado del otro. Sin flex-shrink: 0
     en .sidebar (ver sidebar.css) el navegador le quita ancho cuando falta
     espacio, y el texto de cada workspace se aprieta hasta ser ilegible. */
  .shell {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    overflow: hidden;
  }

  .term {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: var(--space-6) 0 var(--space-3);
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .term::-webkit-scrollbar {
    width: 9px;
  }
  .term::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 9px;
  }

  .sp {
    height: 0.9rem;
  }

  .boot {
    color: var(--dim);
    font-size: var(--text-sm);
  }
  .boot .t {
    color: var(--muted);
  }
  .boot .ok {
    color: var(--green);
  }

  /* flex-wrap y no overflow-x: con scroll el panel se recorta y el último
     valor queda fuera de la vista sin ningún indicio. */
  .fetch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) clamp(var(--space-5), 3vw, var(--space-8));
    margin: var(--space-6) 0 var(--space-7);
  }
  .logo {
    flex: 0 0 auto;
    margin: 0;
    white-space: pre;
    line-height: 1.05;
    font-size: clamp(7.5px, 1.28vw, 12px);
    color: var(--green);
  }
  /* Sin min-width el panel se aprieta hasta ser ilegible en vez de bajar. */
  .info {
    flex: 1 1 26ch;
    min-width: min(26ch, 100%);
  }
  .info .title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
    font-weight: 700;
  }
  .info .u {
    color: var(--pink);
  }
  .info .at {
    color: var(--muted);
    font-weight: 400;
  }
  .info .h {
    color: var(--cyan);
  }
  .info .rule {
    color: var(--line);
    margin-bottom: var(--space-2);
  }
  .info dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 var(--space-5);
    margin: 0;
  }
  .info dt {
    color: var(--blue);
  }
  .info dd {
    margin: 0;
    color: var(--fg);
  }

  .lead {
    color: var(--fg);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--lh-snug);
    text-wrap: balance;
    margin: 0 0 var(--space-5);
    max-width: 46ch;
  }
  .lead strong {
    color: var(--fg);
    font-weight: 700;
  }
  .lead .sig {
    color: var(--green);
    font-weight: 700;
  }
  .note {
    color: var(--dim);
    margin: 0;
  }

  /* La barra de estado vive en Statusline.astro: sus reglas están ahí. Este
     .spacer es del pie de página, que sigue viviendo acá. */
  .spacer {
    flex: 1 1 auto;
  }

  /* Debajo de la statusline y no dentro: lo legal tiene que ser rastreable.
     A todo el ancho del visor, como la statusline: .wrap lo dejaba centrado
     en una columna de 96ch, desalineado del resto de la maqueta. */
  .foot {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) clamp(var(--space-4), 3vw, var(--space-7));
    background: var(--bg);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--dim);
  }
  .foot a {
    color: var(--dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .foot a:hover,
  .foot a:focus-visible {
    color: var(--blue);
    border-bottom-color: var(--blue);
  }

  @media (max-width: 660px) {
    /* La barra lateral se apila arriba del contenido en vez de ir al costado:
       a este ancho no hay sitio para las dos columnas. */
    .shell {
      flex-direction: column;
    }
    .fetch {
      gap: var(--space-6);
    }
    .logo {
      align-self: center;
      font-size: clamp(7.5px, 2.6vw, 12px);
    }
    .lead {
      font-size: var(--text-md);
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .term {
      cursor: default;
    }
  }
</style>
