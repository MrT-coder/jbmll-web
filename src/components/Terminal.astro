---
import '../styles/terminal.css';
import bannerRaw from '../data/banner.txt?raw';
import { SECCIONES } from '../lib/content';
import { esc } from '../lib/render';

interface Props {
  /** Sección montada, o null en la raíz. Decide la ruta y la pestaña activa. */
  seccion?: string | null;
  /** Salida inicial, ya renderizada por src/lib/render.ts. */
  salida?: string;
  /** El arranque solo tiene sentido la primera vez, en la raíz. */
  boot?: boolean;
  /** Frase de encabezado, cuando la página tiene algo que decir antes. */
  lead?: string;
}

const { seccion = null, salida = '', boot = false, lead } = Astro.props;

// Los espacios finales son parte del dibujo y los editores los borran, así que
// el ancho se restituye acá. El \r se limpia por finales de línea de Windows.
const rows = bannerRaw
  .replace(/\r/g, '')
  .replace(/\n+$/, '')
  .split('\n');
const width = Math.max(...rows.map((r) => r.length));
const banner = rows.map((r) => r.padEnd(width)).join('\n');

// Área de Uso Privado de Unicode: solo existe gracias a la fuente empaquetada.
const BRAIN = '';
// Viaja por data-brain y no por define:vars: define:vars obliga a Astro a
// dejar el script en línea, y un script en línea exige aflojar la CSP.

const BOOT = [
  ['0.000000', 'jbsh 1.0 — arrancando'],
  ['0.118431', 'montando ' + SECCIONES.map((s) => '/' + s.slug).join(' ')],
  ['0.240902', 'FiraCode Nerd Font Mono · subconjunto de 432 glifos'],
  ['0.402118', 'listo'],
];

const ruta = seccion ? `~/${seccion}` : '~/';

// El comando que dejó la pantalla así. Se muestra ejecutado, no se ejecuta:
// quien llega desde un buscador ve la terminal en el estado de esa URL.
const comando = seccion ? `cd ${seccion}` : 'ls';
---

<nav class="tabs" id="tabs" aria-label="Secciones">
  {
    SECCIONES.map((s, i) => (
      <a href={`/${s.slug}`} aria-current={s.slug === seccion ? 'page' : undefined} title={s.desc}>
        <span class="num">{i + 1}:</span>{s.slug}
      </a>
    ))
  }
</nav>

<main class="term" id="term" tabindex="-1" data-brain={BRAIN} data-seccion={seccion ?? ''}>
  <div class="wrap">
    <div id="scroll" aria-live="polite">
      {
        boot && (
          <div class="boot">
            {BOOT.map(([t, msg]) => (
              <div class="out">
                <span class="t">[ {t} ] </span>{msg}
                {msg === 'listo' && <span class="ok">  ok</span>}
              </div>
            ))}
          </div>
        )
      }

      {
        boot && (
          <div class="fetch">
            <pre class="logo" aria-hidden="true">{banner}</pre>
            <div class="info">
              <p class="title">
                <span class="u">josue</span><span class="at">@</span><span class="h">jbmll-web</span>
              </p>
              <div class="rule">{'─'.repeat(30)}</div>
              <slot name="info" />
            </div>
          </div>
        )
      }

      {lead && <h1 class="out lead" set:html={lead} />}

      <div class="out done">
        <span class="brain ok">{BRAIN}</span><span class="typed">{comando}</span>
      </div>

      <div id="salida" set:html={salida}></div>

      <slot />
      <div class="out sp"></div>
    </div>
  </div>
</main>

<div class="status">
  <div class="wrap">
    <span class="mode">NORMAL</span>
    <span class="seg path" id="st-path">{ruta}</span>
    <span class="seg hide-sm">{SECCIONES.length} secciones</span>
    <span class="spacer"></span>
    <span class="seg right" id="st-clock">--:--</span>
  </div>
</div>

<footer class="foot">
  <div class="wrap">
    <span>© 2026 Josue Bladimir Morales Llanganate</span>
    <span class="spacer"></span>
    <a href="https://github.com/MrT-coder" rel="me noopener">github</a>
  </div>
</footer>

<script>
  // La terminal vive en un .ts para que `tsc` la revise: un script suelto
  // dentro de un .astro no lo comprueba nadie.
  import '../scripts/terminal';
</script>

<style>
  /* Navegación visible aparte de la terminal: quien llega de un buscador no
     tiene por qué saber que puede escribir. */
  .tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--line);
    padding: 0 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tabs a {
    padding: 0.45rem 1.1ch;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }

  .tabs a:hover,
  .tabs a:focus-visible {
    color: var(--fg);
  }

  .tabs a[aria-current='page'] {
    color: var(--green);
    border-bottom-color: var(--green);
  }

  .tabs .num {
    color: var(--dim);
    margin-right: 0.3ch;
  }

  /* El comando que dejó la pantalla en este estado, mostrado ya ejecutado. */
  .done .brain {
    margin-right: 1ch;
    color: var(--green);
  }

  .term {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1.35rem 0 0.5rem;
    cursor: text;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .term::-webkit-scrollbar {
    width: 9px;
  }
  .term::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 9px;
  }

  .sp {
    height: 0.9rem;
  }

  .boot {
    color: var(--dim);
    font-size: 0.9em;
  }
  .boot .t {
    color: var(--muted);
  }
  .boot .ok {
    color: var(--green);
  }

  /* flex-wrap y no overflow-x: con scroll el panel se recorta y el último
     valor queda fuera de la vista sin ningún indicio. */
  .fetch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.3rem clamp(1rem, 3vw, 2.6rem);
    margin: 1.3rem 0 1.6rem;
  }
  .logo {
    flex: 0 0 auto;
    margin: 0;
    white-space: pre;
    line-height: 1.05;
    font-size: clamp(7.5px, 1.28vw, 12px);
    color: var(--green);
  }
  /* Sin min-width el panel se aprieta hasta ser ilegible en vez de bajar. */
  .info {
    flex: 1 1 26ch;
    min-width: min(26ch, 100%);
  }
  .info .title {
    margin: 0 0 0.15rem;
    font-size: 1em;
    font-weight: 700;
  }
  .info .u {
    color: var(--pink);
  }
  .info .at {
    color: var(--muted);
    font-weight: 400;
  }
  .info .h {
    color: var(--cyan);
  }
  .info .rule {
    color: var(--line);
    margin-bottom: 0.35rem;
  }
  .info dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 1.1rem;
    margin: 0;
  }
  .info dt {
    color: var(--blue);
  }
  .info dd {
    margin: 0;
    color: var(--fg);
  }

  .lead {
    color: var(--fg);
    font-size: clamp(1.15em, 2.4vw, 1.45em);
    font-weight: 400;
    line-height: 1.45;
    text-wrap: balance;
    margin: 0 0 1rem;
    max-width: 46ch;
  }
  .lead strong {
    color: var(--fg);
    font-weight: 700;
  }
  .lead .sig {
    color: var(--green);
    font-weight: 700;
  }
  .note {
    color: var(--dim);
    margin: 0;
  }

  .status {
    flex: 0 0 auto;
    background: var(--panel);
    border-top: 1px solid var(--line);
    font-size: 0.82em;
    white-space: nowrap;
    overflow: hidden;
  }
  .status .wrap {
    display: flex;
    align-items: center;
    padding: 0;
  }
  .status .mode {
    background: var(--gold);
    color: #06080f;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    letter-spacing: 0.06em;
  }
  .status .seg {
    padding: 0.2rem 0.7rem;
    color: var(--muted);
  }
  .status .seg.path {
    color: var(--blue);
  }
  .status .seg.right {
    color: var(--dim);
  }
  .spacer {
    flex: 1 1 auto;
  }

  /* Debajo de la statusline y no dentro: lo legal tiene que ser rastreable. */
  .foot {
    flex: 0 0 auto;
    background: var(--bg);
    border-top: 1px solid var(--line);
    font-size: 0.78em;
    color: var(--dim);
  }
  .foot .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }
  .foot a {
    color: var(--dim);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .foot a:hover,
  .foot a:focus-visible {
    color: var(--blue);
    border-bottom-color: var(--blue);
  }

  @media (max-width: 660px) {
    .hide-sm {
      display: none;
    }
    .fetch {
      gap: 1.3rem;
    }
    .logo {
      align-self: center;
      font-size: clamp(7.5px, 2.6vw, 12px);
    }
    .lead {
      font-size: 1.05em;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .term {
      cursor: default;
    }
    .foot .wrap {
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
    }
  }
</style>
