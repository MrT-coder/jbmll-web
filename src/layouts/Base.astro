---
import '../styles/tokens.css';
import '../styles/reader.css';
import { idiomaDeRuta, rutaAlternativa } from '../i18n/rutas';

interface Props {
  title: string;
  description: string;
  /** false solo en la 404: se sirve en cualquier ruta inexistente, así que
   * no tiene una URL propia que declarar ni debe indexarse. */
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;

// Con build.format 'file' la ruta llega como /proyectos.html o /index.html,
// pero Cloudflare Pages redirige esas URL a /proyectos y a /, que son las que
// lista el sitemap. La canónica declara la URL final, no la que redirige.
const ruta = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
// La portada en inglés es /en, sin barra: con build.format 'file' Astro la emite
// como en.html y Cloudflare la sirve ahí, igual que el sitemap la lista.
const rutaCanonica = ruta;
const canonical = new URL(rutaCanonica, Astro.site);

// El idioma lo dice la URL, no una prop: una página que se olvidara de pasarlo
// saldría en español dentro de /en/ sin que nada lo notara.
const lang = idiomaDeRuta(ruta);
const otro = lang === 'es' ? 'en' : 'es';
// Todas las páginas indexables existen en los dos idiomas (mismos slugs), así
// que cada una declara a su par. x-default es el español, el idioma de la raíz.
const alterna = new URL(rutaAlternativa(rutaCanonica, lang), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Josue Bladimir Morales Llanganate" />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    {
      indexable && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={otro} href={alterna} />
          <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonical : alterna} />
        </>
      )
    }

    <meta name="theme-color" content="#06080F" />
    <!-- El favicon es el prompt solo, no el logo completo: a 16 px el logo se
         empasta (medido en el navegador). El logo entero vive en /logo.svg y
         se usa donde hay píxeles de sobra. -->
    <!-- El ?v= no es decorativo: los navegadores guardan el favicon en una
         caché propia que no se refresca ni con recarga forzada, así que quien
         ya visitó el sitio seguía viendo el anterior. Cambiar la URL es la
         única forma de que lo vuelvan a pedir. Se sube el número cuando el
         dibujo cambie. -->
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <!-- iOS ignora el favicon SVG: sin este PNG recorta una captura de la
         página para el icono de la pantalla de inicio. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- crossorigin es obligatorio en fuentes aunque sean del mismo origen: sin
         él el navegador descarta la precarga y descarga el archivo dos veces. -->
    <link rel="preload" href="/fonts/jb-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_EC' : 'en_US'} />
    {indexable && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_EC'} />}
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <slot />
  </body>
</html>
