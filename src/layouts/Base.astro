---
import '../styles/tokens.css';
import '../styles/reader.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Con build.format 'file' la ruta llega como /proyectos.html o /index.html,
// pero Cloudflare Pages redirige esas URL a /proyectos y a /, que son las que
// lista el sitemap. La canónica declara la URL final, no la que redirige.
const ruta = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
const canonical = new URL(ruta, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Josue Bladimir Morales Llanganate" />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#06080F" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- crossorigin es obligatorio en fuentes aunque sean del mismo origen: sin
         él el navegador descarta la precarga y descarga el archivo dos veces. -->
    <link rel="preload" href="/fonts/jb-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_EC" />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <slot />
  </body>
</html>
