---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Visor from '../components/Visor.astro';
import DescargarCv from '../components/DescargarCv.astro';
import { render } from 'astro:content';
import {
  getPagina,
  getPerfil,
  getExperiencia,
  getEducacion,
  getCertificaciones,
  getStack,
  getProyectos,
  getTechsConPagina,
  MINIMO_PARA_PAGINA_DE_STACK,
  seccionDe,
  type Idioma,
} from '../lib/content';
import { renderStack, slugTech, rutaMedia, propsExterno, marcaExterna } from '../lib/render';
import { iconoDe } from '../data/iconos';
import { rutaLocal } from '../i18n/rutas';
import { TEXTOS_PAGINAS } from '../i18n/paginas';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const T = TEXTOS_PAGINAS[lang].sobreMi;

const [perfil, pagina, experiencia, educacion, certificaciones, stack, conPagina, proyectos] = await Promise.all([
  getPerfil(lang),
  getPagina('sobre-mi', lang),
  getExperiencia(lang),
  getEducacion(lang),
  getCertificaciones(lang),
  getStack(lang),
  getTechsConPagina(lang),
  getProyectos(lang),
]);
const proyectoPorId = new Map(proyectos.map((p) => [p.id, p]));

// La prosa la escribe el Markdown; los bloques de abajo salen de los datos.
const Prosa = pagina ? (await render(pagina)).Content : null;
const { titulo, lead } = await seccionDe('sobre-mi', lang);

// Experiencia, certificaciones y educación son colecciones separadas en los
// datos y bloques de una sola página en la vista. El día que crezcan se
// independizan sin migrar nada.
const periodo = (inicio: string, fin?: string) => `${inicio} — ${fin ?? T.presente}`;
const modalidad = (m: string) => TEXTOS_PAGINAS[lang].modalidad[m] ?? m;
---

<Base
  title={titulo}
  description={T.descripcion(perfil.titular)}
>
  <Terminal lang={lang} seccion="sobre-mi" salida="">
    <section class="bloque">
      <h1 class="out lead">{lead}</h1>
      <p class="out note"># {perfil.titular} · {perfil.ubicacion}</p>
      {Prosa && <div class="prose intro"><Prosa /></div>}
      <DescargarCv lang={lang} />
      {
        // Una sola línea, no un bloque propio: la ficha completa (etiqueta +
        // enlace + marca de afiliado) ya vive en /contacto — ver
        // `distribuidor` en src/content.config.ts y src/pages/contacto.astro.
        // Acá alcanza con mencionarlo sin repetir la tabla; la marca va en la
        // misma línea que el enlace y se asocia a él con aria-describedby.
        perfil.distribuidor && (
          <p class="out note">
            # {perfil.distribuidor.etiqueta}:{' '}
            {/* target/rel y el anuncio de pestaña nueva salen de
               propsExterno()/MARCA_EXTERNA en src/lib/render.ts, la misma
               decisión que usa la ficha completa en /contacto: no se repiten
               a mano. */}
            <a
              class="go"
              href={perfil.distribuidor.href}
              aria-describedby="marca-distribuidor"
              {...propsExterno(perfil.distribuidor.href, 'sponsored')}
            >
              {perfil.distribuidor.href.replace(/^https?:\/\//, '')}
              <Fragment set:html={marcaExterna(lang)} />
            </a>
            <span class="marca-afiliado" id="marca-distribuidor">{perfil.distribuidor.divulgacion}</span>
          </p>
        )
      }
    </section>

    <section class="bloque" id="stack">
      <h2 class="bloque-t">{T.stack}</h2>
      <p class="out note">{T.notaStack}</p>
      <div set:html={renderStack(stack, MINIMO_PARA_PAGINA_DE_STACK, lang)} />
    </section>

    <section class="bloque" id="experiencia">
      <h2 class="bloque-t">{T.experiencia}</h2>
      {
        experiencia.map((e) => (
          <article class="item">
            <h3 class="item-t">
              {e.data.puesto} <span class="item-org">· {e.data.organizacion}</span>
            </h3>
            <p class="item-m">
              {periodo(e.data.inicio, e.data.fin)} · {e.data.ubicacion}
              {e.data.modalidad && ` · ${modalidad(e.data.modalidad)}`}
            </p>
            {
              e.data.proyectos.length > 0 && (
                <p class="item-m">
                  {T.proyectosDelPuesto}:{' '}
                  {e.data.proyectos
                    .flatMap((id) => proyectoPorId.get(id) ?? [])
                    .map((p, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a class="go" href={rutaLocal(lang, `/proyectos/${p.id}`)}>
                          {p.data.titulo}
                        </a>
                      </>
                    ))}
                </p>
              )
            }
            {e.data.st.length > 0 && (
              <ul class="chips">
                {e.data.st.map((t) => (
                  <li>
                    {conPagina.has(t) ? (
                      <a class="chip" href={rutaLocal(lang, `/stack/${slugTech(t)}`)}>
                        <span class="ico" aria-hidden="true">{iconoDe(t)}</span>{t}
                      </a>
                    ) : (
                      <span class="chip">
                        <span class="ico" aria-hidden="true">{iconoDe(t)}</span>{t}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section class="bloque" id="educacion">
      <h2 class="bloque-t">{T.educacion}</h2>
      {
        educacion.map((e) => (
          <article class="item">
            <h3 class="item-t">
              {e.data.titulo} <span class="item-org">· {e.data.institucion}</span>
            </h3>
            <p class="item-m">
              {periodo(e.data.inicio, e.data.fin)} · {e.data.ubicacion}
              {e.data.registro && ` · ${e.data.registro}`}
            </p>
          </article>
        ))
      }
    </section>

    <section class="bloque" id="certificaciones">
      <h2 class="bloque-t">{T.certificaciones}</h2>
      <table class="list list-certs">
        <thead class="solo-lector">
          <tr>
            <th scope="col">{T.columnas.nombre}</th>
            <th scope="col">{T.columnas.fecha}</th>
            <th scope="col">{T.columnas.emisor}</th>
            <th scope="col">{T.columnas.archivo}</th>
          </tr>
        </thead>
        <tbody>
          {
            certificaciones.map((c) => (
              <tr>
                <td class="n">{c.data.nombre}</td>
                <td class="c">{c.data.fecha ?? '—'}</td>
                <td class="d">
                  {[c.data.emisor, c.data.horas && `${c.data.horas} ${T.horas}`].filter(Boolean).join(' · ')}
                </td>
                <td class="acc">
                  {c.data.archivo && (
                    <a
                      class="go visor-abrir"
                      href={rutaMedia(c.data.archivo)}
                      target="_blank"
                      rel="noopener"
                      aria-label={T.verCertificado(c.data.nombre)}
                      data-nombre={c.data.nombre}
                    >
                      {T.ver}
                    </a>
                  )}
                  {c.data.url && (
                    // A diferencia del enlace [ver] de arriba (que abre
                    // /media/ en el visor flotante, ver el comentario de esa
                    // columna en src/lib/tipos.ts / Visor.astro), este apunta
                    // al emisor de la certificación: un sitio de verdad
                    // externo, así que target/rel salen de propsExterno().
                    // El anuncio de pestaña nueva va DENTRO del propio
                    // aria-label —no como el <span class="sr-only"> que trae
                    // MARCA_EXTERNA— porque un aria-label ya puesto reemplaza
                    // por completo el contenido del enlace como nombre
                    // accesible: ese span quedaría escrito pero invisible
                    // para cualquier lector de pantalla.
                    <a
                      class="go"
                      href={c.data.url}
                      {...propsExterno(c.data.url)}
                      aria-label={T.verificarCertificado(c.data.nombre)}
                    >
                      {T.verificar}
                      <span class="externo" aria-hidden="true"> ↗</span>
                    </a>
                  )}
                  {c.data.credencial && <span class="cred">{c.data.credencial}</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <Visor lang={lang} />
    </section>
  </Terminal>
</Base>

<style>
  .bloque {
    margin: var(--space-7) 0;
  }

  .bloque-t {
    margin: 0 0 var(--space-3);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--green);
  }

  .bloque-t::before {
    content: '## ';
    color: var(--dim);
  }

  .item {
    margin: 0 0 var(--space-6);
    padding-left: 1.5ch;
    border-left: 1px solid var(--line);
  }

  .item-t {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 700;
  }

  .item-org {
    font-weight: 400;
    color: var(--muted);
  }

  .item-m {
    margin: var(--space-1) 0 0;
    color: var(--dim);
    font-size: var(--text-sm);
  }

  /* [ver]/[verificar] y la credencial, en la misma celda: flex y no una lista,
     porque no siempre están los tres — una certificación puede traer solo uno
     o ninguno. */
  .acc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  /* Discreta a propósito: el id de credencial no es información que alguien
     lea primero, es una prueba que queda ahí para quien la necesite. */
  .cred {
    color: var(--dim);
    font-size: var(--text-xs);
  }

  /* Cuatro columnas no caben en un teléfono: a 390px los nombres largos se
     partían carácter por carácter («Fund acio n Carl»). Solo esta tabla se
     apila —.list también arma la de contacto y la de stack, que sí caben—, y
     cada certificación pasa a ser un bloque con su nombre, su fecha, su
     emisor y sus enlaces uno debajo del otro. Mismo punto de quiebre que el
     resto del sitio. */
  @media (max-width: 660px) {
    .list-certs tr {
      display: grid;
      gap: var(--space-1);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--line);
    }

    /* Apilada, la alineación de una columna deja de tener sentido: cada dato
       arranca donde arranca el nombre. */
    .list-certs td {
      padding: 0;
      text-align: left;
    }

    /* Una certificación sin emisor o sin enlaces dejaba una fila en blanco
       dentro de su bloque, que se leía como un dato que falta cargar. */
    .list-certs td:empty {
      display: none;
    }
  }
</style>
