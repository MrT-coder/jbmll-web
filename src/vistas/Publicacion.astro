---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Visor from '../components/Visor.astro';
import type { Idioma, Publicacion } from '../lib/content';
import { propsExterno, marcaExterna } from '../lib/render';
import { rutaLocal } from '../i18n/rutas';
import { TEXTOS_PAGINAS } from '../i18n/paginas';

// Solo las publicaciones con algo propio que decir tienen página; cuáles son lo
// decide src/lib/rutas-estaticas.ts. Esta vista solo dibuja.
interface Props {
  lang: Idioma;
  publicacion: Publicacion;
  anterior: Publicacion | null;
  siguiente: Publicacion | null;
}

const { lang, publicacion, anterior, siguiente } = Astro.props;
const T = TEXTOS_PAGINAS[lang].publicaciones;
const { Content } = await render(publicacion);
const doi = publicacion.data.doi ? `https://doi.org/${publicacion.data.doi}` : publicacion.data.url;
---

<Base
  title={`${publicacion.data.titulo} — JBMLL`}
  description={`${publicacion.data.venue} · ${publicacion.data.anio}`}
>
  <Terminal
    lang={lang}
    seccion="publicaciones"
    salida=""
    detalle
    documento={{ href: rutaLocal(lang, `/publicaciones/${publicacion.id}`), titulo: publicacion.data.titulo, tipo: 'publicacion' }}
  >
    <article class="lectura">
      <h1 class="lectura-t">{publicacion.data.titulo}</h1>
      <p class="lectura-m">
        {publicacion.data.autores.join('; ')}
        <br />
        {[publicacion.data.venue, publicacion.data.serie, publicacion.data.anio]
          .filter(Boolean)
          .join(' · ')}
      </p>

      <div class="prose">
        <Content />
      </div>

      <!-- Mismo candado que en proyectos/[slug].astro: sin este componente,
           las figuras y los enlaces a PDF que arma rehype-figuras.mjs no
           tienen ningún <dialog id="visor"> que scripts/visor.ts pueda abrir. -->
      <Visor lang={lang} />

      <footer class="eof">
        <p class="eof-mark">(END)</p>
        <ul class="eof-acts">
          <li>
            <a href={rutaLocal(lang, '/publicaciones')}><kbd>q</kbd>{T.volver}</a>
          </li>
          {
            doi && (
              <li>
                {/* doi.org o el `url` que cargó el dueño: siempre un sitio
                   ajeno, pero se decide con propsExterno() y no a mano, como
                   el resto del sitio. */}
                <a href={doi} {...propsExterno(doi)}>
                  <kbd>o</kbd>
                  {publicacion.data.doi ? T.abrirDoi : T.abrirOriginal}
                  <Fragment set:html={marcaExterna(lang)} />
                </a>
              </li>
            )
          }
          {
            anterior && (
              <li>
                <a href={rutaLocal(lang, `/publicaciones/${anterior.id}`)}>
                  <kbd>k</kbd>
                  {anterior.data.titulo}
                </a>
              </li>
            )
          }
          {
            siguiente && (
              <li>
                <a href={rutaLocal(lang, `/publicaciones/${siguiente.id}`)}>
                  <kbd>j</kbd>
                  {siguiente.data.titulo}
                </a>
              </li>
            )
          }
        </ul>
      </footer>
    </article>
  </Terminal>
</Base>
