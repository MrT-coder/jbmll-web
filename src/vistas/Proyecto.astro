---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Visor from '../components/Visor.astro';
import { etiquetaEstado, etiquetaContexto, type Idioma, type Proyecto } from '../lib/content';
import { slugTech } from '../lib/render';
import { rutaLocal } from '../i18n/rutas';
import { TEXTOS_PAGINAS } from '../i18n/paginas';

// Las rutas y las props las arma la página de cada idioma (src/lib/rutas-estaticas.ts):
// esta vista solo dibuja.
interface Props {
  lang: Idioma;
  proyecto: Proyecto;
  conPagina: Set<string>;
  anterior: Proyecto | null;
  siguiente: Proyecto | null;
}

const { lang, proyecto, conPagina, anterior, siguiente } = Astro.props;
const T = TEXTOS_PAGINAS[lang].proyectos;

// El cuerpo lo procesa Astro al compilar. Al navegador no llega ni un byte de
// analizador de Markdown.
const { Content } = await render(proyecto);

// Mismo criterio que metaDeFila() en src/lib/render.ts, para que el índice y
// esta página de detalle lean exactamente lo mismo: el estado va coloreado y
// aparte, el contexto (si existe) justo después, y el resto de la línea
// (organización, fecha) cierra igual que antes.
const estadoEtiqueta = etiquetaEstado(proyecto.data.estado, lang);
const contextoEtiqueta = proyecto.data.contexto ? etiquetaContexto(proyecto.data.contexto, lang) : null;
const meta = [proyecto.data.organizacion, proyecto.data.fecha].filter(Boolean).join(' · ');
---

<Base title={`${proyecto.data.titulo} — JBMLL`} description={proyecto.data.desc}>
  <Terminal
    lang={lang}
    seccion="proyectos"
    salida=""
    detalle
    documento={{ href: rutaLocal(lang, `/proyectos/${proyecto.id}`), titulo: proyecto.data.titulo, tipo: 'proyecto' }}
  >
    <article class="lectura">
      <h1 class="lectura-t">{proyecto.data.titulo}</h1>
      <p class="lectura-m">
        <span class={`estado estado-${proyecto.data.estado}`}>{estadoEtiqueta}</span>
        {contextoEtiqueta && ` · ${contextoEtiqueta}`}
        {meta && ` · ${meta}`}
      </p>

      <ul class="chips">
        {
          proyecto.data.st.map((t) => (
            <li>
              {conPagina.has(t) ? (
                <a class="chip" href={rutaLocal(lang, `/stack/${slugTech(t)}`)}>
                  {t}
                </a>
              ) : (
                <span class="chip">{t}</span>
              )}
            </li>
          ))
        }
      </ul>

      <div class="prose">
        <Content />
      </div>

      <!-- El visor flotante que rehype-figuras.mjs ya sabe usar (clase
           visor-abrir en cada figura y en cada PDF propio del cuerpo): sin
           este componente aquí, esos enlaces existen en el HTML pero no hay
           ningún <dialog id="visor"> que scripts/visor.ts pueda abrir — el
           mismo candado que ya hace falta en /sobre-mi para certificados. -->
      <Visor lang={lang} />

      <footer class="eof">
        <p class="eof-mark">(END)</p>
        <ul class="eof-acts">
          <li>
            <a href={rutaLocal(lang, '/proyectos')}><kbd>q</kbd>{T.volver}</a>
          </li>
          {
            anterior && (
              <li>
                <a href={rutaLocal(lang, `/proyectos/${anterior.id}`)}>
                  <kbd>k</kbd>
                  {anterior.data.titulo}
                </a>
              </li>
            )
          }
          {
            siguiente && (
              <li>
                <a href={rutaLocal(lang, `/proyectos/${siguiente.id}`)}>
                  <kbd>j</kbd>
                  {siguiente.data.titulo}
                </a>
              </li>
            )
          }
        </ul>
      </footer>
    </article>
  </Terminal>
</Base>
