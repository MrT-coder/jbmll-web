---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { getExperiencia, getIndice, getPerfil, type Idioma } from '../lib/content';
import { mesesDeExperiencia } from '../lib/experiencia';
import { renderSecciones } from '../lib/render';
import { TEXTOS_PAGINAS } from '../i18n/paginas';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const T = TEXTOS_PAGINAS[lang].inicio;

const indice = await getIndice(lang);
const perfil = await getPerfil(lang);
const experiencia = await getExperiencia(lang);
const periodos = experiencia.map((x) => ({ inicio: x.data.inicio, fin: x.data.fin }));
// Valor del build: lo que ven quienes no ejecutan JavaScript. El script del
// final lo recalcula con la fecha de quien visita la página.
const meses = mesesDeExperiencia(periodos);

const INFO = [
  [T.autor, perfil.nombre],
  [T.rol, perfil.titular],
  [T.ubicacion, perfil.ubicacion],
  [T.stack, T.stackValor(indice.stack.length)],
  [T.experiencia, T.experienciaValor(meses)],
];
---

<Base
  title={indice.inicio.titulo}
  description={T.descripcion}
>
  <Terminal
    lang={lang}
    seccion=""
    boot
    lead={indice.inicio.lead}
    salida={renderSecciones(indice.secciones, lang)}
    foto={perfil.foto}
  >
    <dl slot="info">
      {
        INFO.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            {k === T.experiencia ? (
              <dd data-experiencia={JSON.stringify(periodos)} data-lang={lang}>
                {v}
              </dd>
            ) : (
              <dd>{v}</dd>
            )}
          </>
        ))
      }
    </dl>
  </Terminal>
</Base>

<script>
  import { mesesDeExperiencia, type Periodo } from '../lib/experiencia';
  import { TEXTOS_PAGINAS } from '../i18n/paginas';

  // Recalcula con la fecha de quien visita: el HTML estático solo sabe la del build.
  const el = document.querySelector<HTMLElement>('[data-experiencia]');
  if (el) {
    try {
      const periodos: Periodo[] = JSON.parse(el.dataset.experiencia ?? '[]');
      const lang = el.dataset.lang === 'en' ? 'en' : 'es';
      el.textContent = TEXTOS_PAGINAS[lang].inicio.experienciaValor(mesesDeExperiencia(periodos));
    } catch {
      // Se queda el valor del build.
    }
  }
</script>
