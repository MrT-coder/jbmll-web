node_modules/
dist/
.astro/
.wrangler/

# Variables de entorno. El token que lee D1 durante el build vivirá acá cuando
# llegue el momento, y no puede entrar nunca al repositorio.
.env
.env.*
!.env.example

# Herramientas del entorno de trabajo, no del proyecto.
.atl/
.DS_Store
Thumbs.db

# Secretos locales de Wrangler. Cloudflare los lee en desarrollo igual que .env,
# y nadie los asocia con un archivo de entorno hasta que ya se subieron.
.dev.vars
.dev.vars.*

# Configuración de editor: es del equipo de quien escribe, no del proyecto.
.vscode/
.idea/
*.swp

# Registros de npm y de las herramientas. Traen rutas absolutas de la máquina.
*.log
npm-debug.log*
